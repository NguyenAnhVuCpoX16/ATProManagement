@page "/admin/clients"
@inject IMainContext _ctx
@inject ISweetAlertService _swal
@inject IDialogService Dialog
@inject IJSRuntime js
@inject LayoutStateService _layoutState
<style>

    .client-dashboard {
        min-height: 100vh;
        padding: 28px;
    }

    /* TOP BANNER */

    .top-banner {
        border-radius: 28px;
        padding: 32px;
        margin-bottom: 24px;
        background: linear-gradient(135deg,#ff6f00,#ff9800);
        color: white;
        overflow: hidden;
        position: relative;
    }

        .top-banner::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
            right: -100px;
            top: -100px;
        }

    .banner-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        position: relative;
        z-index: 2;
    }

    .banner-title {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .banner-subtitle {
        opacity: .9;
    }

    /* SIDEBAR */

    .side-card {
        border-radius: 24px;
        padding: 22px;
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.04);
    }

    .total-card {
        background: linear-gradient(135deg,#1e293b,#334155);
        color: white;
    }

    .side-icon {
        margin-bottom: 12px;
    }

    .mini-stat {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .mini-avatar {
        width: 48px;
        height: 48px;
        color: white !important;
    }

    .blue-bg {
        background: linear-gradient(135deg,#2196F3,#64B5F6);
    }

    .orange-bg {
        background: linear-gradient(135deg,#ff9800,#ffb74d);
    }

    .green-bg {
        background: linear-gradient(135deg,#4CAF50,#81C784);
    }

    /* TABLE PANEL */

    .table-panel {
        border-radius: 28px;
        padding: 24px;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(0,0,0,.04);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .search-input {
        width: 280px;
    }

        .search-input .mud-input-control {
            border-radius: 16px;
        }

    /* TABLE */
    .modern-table .mud-table-container {
        max-height: 700px;
        overflow-y: auto;
    }

    /* giữ header */
    .modern-table thead {
        position: sticky;
        top: 0;
        background: white;
        z-index: 2;
    }

        .modern-table .mud-table-head {
            background: #f8fafc;
        }

            .modern-table .mud-table-head .mud-table-cell {
                font-weight: 700;
                color: #64748b;
                border-bottom: 1px solid #e2e8f0;
                padding-top: 18px;
                padding-bottom: 18px;
            }

        .modern-table .mud-table-body .mud-table-cell {
            padding-top: 18px;
            padding-bottom: 18px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    /* CLIENT */

    .client-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .client-avatar {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg,#ff6f00,#ffb74d) !important;
        color: white !important;
        font-weight: 700;
        font-size: 1rem;
    }

    .client-name {
        font-weight: 700;
        color: #1e293b;
    }

    .client-email {
        font-size: .82rem;
        color: #94a3b8;
    }

    /* MOBILE */

    @@media(max-width: 960px) {

        .client-dashboard {
            padding: 16px;
        }

        .banner-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .table-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-input {
            width: 100%;
        }

        .table-panel,
        .top-banner,
        .side-card {
            border-radius: 20px;
        }
    }

</style>

<MudContainer MaxWidth="MaxWidth.False" Class="client-dashboard main-background">
    <!-- TOP HEADER -->
    <Toolbar Title="Clients" OnRefresh="LoadData" OnExcelExport="ExportToExcel" OnPdfExport="ExportToPDF"/>
    <!-- DASHBOARD -->
    <MudGrid Class="mt-1">
        <!-- LEFT SIDE -->
        <MudItem xs="12" lg="3">
            <MudStack Spacing="3">
                <!-- STATS -->
                <MudPaper Class="side-card total-card">
                    <MudIcon Icon="@Icons.Material.Filled.Groups"
                             Size="Size.Large"
                             Class="side-icon" />
                    <MudText Typo="Typo.caption">
                        TOTAL CLIENTS
                    </MudText>
                    <MudText Typo="Typo.h3" Class="fw-bold">
                        @_clients?.Count
                    </MudText>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                New Today
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                12
                            </MudText>
                        </div>
                        <MudAvatar Class="mini-avatar blue-bg">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                        </MudAvatar>
                    </div>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                Messages
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                45
                            </MudText>
                        </div>

                        <MudAvatar Class="mini-avatar orange-bg">
                            <MudIcon Icon="@Icons.Material.Filled.Mail" />
                        </MudAvatar>
                    </div>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                Courses
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                8
                            </MudText>
                        </div>
                        <MudAvatar Class="mini-avatar green-bg">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                        </MudAvatar>
                    </div>
                </MudPaper>
            </MudStack>
        </MudItem>

        <!-- RIGHT SIDE -->
        <MudItem xs="12" lg="9">
            @if (_clients?.Count >= 0)
            {
                <MudPaper Class="table-panel">
                    <!-- TOOLBAR -->
                    <div class="table-toolbar">
                        <div>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                Client List
                            </MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                List of all registered clients
                            </MudText>
                        </div>
                        <MudTextField T="string"
                                      Placeholder="Search..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      Class="search-input"
                                      Immediate="true"
                                      TextChanged="OnSearchChanged" />
                        <MudSelect T="string"
                                   Variant="Variant.Text"
                                   Placeholder="Search Courses"
                                   ValueChanged="OnCourseChanged">
                            @foreach (var course in _course)
                            {
                                <MudSelectItem Value="course">@course</MudSelectItem>
                            }
                        </MudSelect>
                        <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddNew"></MudIconButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="DeleteRange" Disabled="@(_layoutState.IsDesktop != true)"></MudIconButton>
                        </MudButtonGroup>
                    </div>
                    <!-- TABLE -->
                    <MudTable T="EntityClient"
                              @bind-SelectedItems="_selectedsClients"
                              MultiSelection="_layoutState.IsDesktop"
                              Items="_clients"
                              Hover="true"
                              Dense="true"
                              Breakpoint="Breakpoint.Sm"
                              Class="modern-table"
                              RowsPerPage="25">
                        <HeaderContent>
                            <MudTh>Client</MudTh>
                            <MudTh>Course</MudTh>
                            <MudTh>Phone</MudTh>
                            <MudTh>Date</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <div class="client-info">
                                    <MudAvatar Class="client-avatar">
                                        @context.Name?.Substring(0, 1)
                                    </MudAvatar>
                                    <div>
                                        <MudText Class="client-name">
                                            @context.Name
                                        </MudText>
                                        <MudText Class="client-email">
                                            @context.Email
                                        </MudText>
                                    </div>
                                </div>

                            </MudTd>
                            <MudTd>
                                @if (string.IsNullOrEmpty(context.CourseName))
                                {
                                    <span>-</span>
                                }
                                else
                                {
                                    <MudChip T="string"
                                             Color="Color.Warning"
                                             Variant="Variant.Outlined">
                                        <span>@context.CourseName</span>
                                    </MudChip>
                                }
                            </MudTd>
                            <MudTd>
                                @context.Phone
                            </MudTd>

                            <MudTd>
                                @context.TimeCreated.ToString("dd/MM/yyyy")
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                               Size="Size.Small"
                                               Class="action-btn" />
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Success"
                                               Size="Size.Small"
                                               Class="action-btn" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               Class="action-btn" />
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </MudPaper>
            }
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    RenderFragment content;
    RenderFragment footer;
    private string _search = "";
    private string _searchCourse = "";
    List<EntityClient>? _dataSource;
    List<EntityClient>? _clients;
    IClientService service;
    private List<string> _course;
    ModelClient model = new();
    private HashSet<EntityClient> _selectedsClients = new();


    protected override async Task OnInitializedAsync()
    {
        await _swal.Loading();
        service = _ctx.GetService<IClientService>();
        await LoadData();
        var text = await service.GetCourseOptions();
        await _swal.Close();
    }

    private async Task LoadData()
    {
        try
        {
            var response = await service.GetData();
            if (response?.Success == true)
            {
                _dataSource = response.Items?.ToList();
                _clients = _dataSource;
                _course = new List<string> { "All" }
                         .Concat(_dataSource?
                             .Select(c => c.CourseName)
                             .Distinct() ?? Enumerable.Empty<string>())
                         .ToList();
            }
            else
            {
                await _swal.Error(response?.Message ?? "Error");
            }
        }
        catch (Exception ex)
        {
            await _swal.Error("Error loading clients", ex.Message);
        }
    }

    private void OnSearchChanged(string value)
    {
        _search = value;
        Filter();
    }

    private void OnCourseChanged(string value)
    {
        _searchCourse = value == "All" ? "" : value;
        Filter();

    }
    void Filter()
    {
        _clients = _dataSource?.Where(x => (x.Name.ToUpper().Contains(_search.ToUpper())
                                      || x.Phone.ToUpper().Contains(_search.ToUpper())
                                      || x.Email.ToUpper().Contains(_search.ToUpper()))
                                      && x.CourseName.ToUpper().Contains(_searchCourse.ToUpper())).ToList();
    }

    async Task ExportToExcel()
    {
        try
        {
            await _swal.Loading("Downloading...");
            await DownloadHelper.ExportToExcel<EntityClient>(_clients ?? new List<EntityClient>(), js, "Clients.xlsx");
            await _swal.Success("Download successful");
        }
        catch (Exception ex)
        {

            await _swal.Error(ex.Message);
        }
    }

    
    async Task ExportToPDF()
    {
        try
        {
            await _swal.Loading("Downloading...");
            await DownloadHelper.ExportToPdf<EntityClient>(_clients ?? new List<EntityClient>(), js);
            await _swal.Success("Download successful");
        }
        catch (Exception ex)
        {

            await _swal.Error(ex.Message);
        }
    }

    private async Task AddNew()
    {
        try
        {
            model = new();
          
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private async Task DeleteRange()
    {
        try
        {
            if (!_selectedsClients.Any())
            {
                await _swal.Warning("Please select at least one course to delete.");
                return;
            }

            var result = await _swal.Confirm($"Confirm delete {_selectedsClients.Count} selected items?", "Delete");
            if (result == false) return;

            var respone = await service.RemoveRange(_selectedsClients.ToList());
            if (respone.Success)
            {
                await _swal.Success("Delete Successfully");
                await LoadData();
            }
            else
            {
                await _swal.Error(respone.Message);
            }
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }

       
    }
}