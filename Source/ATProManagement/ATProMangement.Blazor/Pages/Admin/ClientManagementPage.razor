@page "/admin/clients"

<MudContainer MaxWidth="MaxWidth.False" Class="client-dashboard">
    <!-- TOP HEADER -->
    <Toolbar Title="Clients"/>
    <!-- DASHBOARD -->
    <MudGrid Class="mt-1">
        <!-- LEFT SIDE -->
        <MudItem xs="12" lg="3">
            <MudStack Spacing="3">
                <!-- STATS -->
                <MudPaper Class="side-card total-card">
                    <MudIcon Icon="@Icons.Material.Filled.Groups"
                             Size="Size.Large"
                             Class="side-icon" />
                    <MudText Typo="Typo.caption">
                        TOTAL CLIENTS
                    </MudText>
                    <MudText Typo="Typo.h3" Class="fw-bold">
                        @_clients.Count
                    </MudText>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                New Today
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                12
                            </MudText>
                        </div>
                        <MudAvatar Class="mini-avatar blue-bg">
                            <MudIcon Icon="@Icons.Material.Filled.TrendingUp" />
                        </MudAvatar>
                    </div>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                Messages
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                45
                            </MudText>
                        </div>

                        <MudAvatar Class="mini-avatar orange-bg">
                            <MudIcon Icon="@Icons.Material.Filled.Mail" />
                        </MudAvatar>
                    </div>
                </MudPaper>
                <MudPaper Class="side-card">
                    <div class="mini-stat">
                        <div>
                            <MudText Typo="Typo.body2">
                                Courses
                            </MudText>
                            <MudText Typo="Typo.h5" Class="fw-bold">
                                8
                            </MudText>
                        </div>
                        <MudAvatar Class="mini-avatar green-bg">
                            <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                        </MudAvatar>
                    </div>
                </MudPaper>
            </MudStack>
        </MudItem>

        <!-- RIGHT SIDE -->
        <MudItem xs="12" lg="9">

            <MudPaper Class="table-panel">
                <!-- TOOLBAR -->
                <div class="table-toolbar">
                    <div>
                        <MudText Typo="Typo.h5" Class="fw-bold">
                            Client List
                        </MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            List of all registered clients
                        </MudText>
                    </div>
                    <MudTextField T="string"
                                  Placeholder="Search..."
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Class="search-input"
                                  @bind-Value="_search" />
                </div>
                <!-- TABLE -->
                <MudTable Items="FilteredClients"
                          Hover="true"
                          Dense="true"
                          Breakpoint="Breakpoint.Sm"
                          Class="modern-table"
                          RowsPerPage="25">
                    <HeaderContent>
                        <MudTh>Client</MudTh>
                        <MudTh>Course</MudTh>
                        <MudTh>Phone</MudTh>
                        <MudTh>Date</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="client-info">
                                <MudAvatar Class="client-avatar">
                                    @context.Name?.Substring(0, 1)
                                </MudAvatar>
                                <div>
                                    <MudText Class="client-name">
                                        @context.Name
                                    </MudText>
                                    <MudText Class="client-email">
                                        @context.Email
                                    </MudText>
                                </div>
                            </div>

                        </MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Color="Color.Warning"
                                     Variant="Variant.Outlined">
                                @context.CourseName
                            </MudChip>
                        </MudTd>
                        <MudTd>
                            @context.Phone
                        </MudTd>

                        <MudTd>
                            @context.TimeCreated.ToString("dd/MM/yyyy")
                        </MudTd>

                        <MudTd>

                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Size="Size.Small"
                                           Class="action-btn" />

                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Success"
                                           Size="Size.Small"
                                           Class="action-btn" />

                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           Class="action-btn" />

                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>

    .client-dashboard {
        min-height: 100vh;
        padding: 28px;
        background: radial-gradient(circle at top left, rgba(255,152,0,.10), transparent 20%), radial-gradient(circle at bottom right, rgba(33,150,243,.08), transparent 20%), #f5f7fb;
    }

    /* TOP BANNER */

    .top-banner {
        border-radius: 28px;
        padding: 32px;
        margin-bottom: 24px;
        background: linear-gradient(135deg,#ff6f00,#ff9800);
        color: white;
        overflow: hidden;
        position: relative;
    }

        .top-banner::before {
            content: "";
            position: absolute;
            width: 300px;
            height: 300px;
            background: rgba(255,255,255,.08);
            border-radius: 50%;
            right: -100px;
            top: -100px;
        }

    .banner-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        position: relative;
        z-index: 2;
    }

    .banner-title {
        font-weight: 800;
        margin-bottom: 6px;
    }

    .banner-subtitle {
        opacity: .9;
    }

    /* SIDEBAR */

    .side-card {
        border-radius: 24px;
        padding: 22px;
        background: rgba(255,255,255,.9);
        border: 1px solid rgba(0,0,0,.04);
        box-shadow: 0 10px 30px rgba(0,0,0,.04);
    }

    .total-card {
        background: linear-gradient(135deg,#1e293b,#334155);
        color: white;
    }

    .side-icon {
        margin-bottom: 12px;
    }

    .mini-stat {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .mini-avatar {
        width: 48px;
        height: 48px;
        color: white !important;
    }

    .blue-bg {
        background: linear-gradient(135deg,#2196F3,#64B5F6);
    }

    .orange-bg {
        background: linear-gradient(135deg,#ff9800,#ffb74d);
    }

    .green-bg {
        background: linear-gradient(135deg,#4CAF50,#81C784);
    }

    /* TABLE PANEL */

    .table-panel {
        border-radius: 28px;
        padding: 24px;
        background: rgba(255,255,255,.88);
        border: 1px solid rgba(0,0,0,.04);
        box-shadow: 0 10px 40px rgba(0,0,0,.05);
    }

    .table-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .search-input {
        width: 280px;
    }

        .search-input .mud-input-control {
            border-radius: 16px;
        }

    /* TABLE */

    .modern-table {
        border-radius: 20px;
        overflow: hidden;
    }

        .modern-table .mud-table-head {
            background: #f8fafc;
        }

            .modern-table .mud-table-head .mud-table-cell {
                font-weight: 700;
                color: #64748b;
                border-bottom: 1px solid #e2e8f0;
                padding-top: 18px;
                padding-bottom: 18px;
            }

        .modern-table .mud-table-body .mud-table-cell {
            padding-top: 18px;
            padding-bottom: 18px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
        }

    /* CLIENT */

    .client-info {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .client-avatar {
        width: 48px;
        height: 48px;
        background: linear-gradient(135deg,#ff6f00,#ffb74d) !important;
        color: white !important;
        font-weight: 700;
        font-size: 1rem;
    }

    .client-name {
        font-weight: 700;
        color: #1e293b;
    }

    .client-email {
        font-size: .82rem;
        color: #94a3b8;
    }

    /* MOBILE */

    @@media(max-width: 960px) {

        .client-dashboard {
            padding: 16px;
        }

        .banner-content {
            flex-direction: column;
            align-items: flex-start;
        }

        .table-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-input {
            width: 100%;
        }

        .table-panel,
        .top-banner,
        .side-card {
            border-radius: 20px;
        }
    }

</style>

@code {

    private string _search = "";
    protected override void OnInitialized()
    {
        FilterClients();
    }

    private List<EntityClient> _clients = new()
    {
        new()
        {
            Guid = Guid.NewGuid(),
            Name = "John Smith",
            Email = "john@gmail.com",
            Phone = "0901234567",
            Message = "Interested in Blazor course",
            CourseName = "Blazor WebAssembly",
            TimeCreated = DateTime.Now.AddDays(-3)
        },

        new()
        {
            Guid = Guid.NewGuid(),
            Name = "Alex Brown",
            Email = "alex@gmail.com",
            Phone = "0912345678",
            Message = "Need more information",
            CourseName = "C# Advanced",
            TimeCreated = DateTime.Now.AddDays(-2)
        },

        new()
        {
            Guid = Guid.NewGuid(),
            Name = "Emily Johnson",
            Email = "emily@gmail.com",
            Phone = "0988888888",
            Message = "Register immediately",
            CourseName = ".NET MAUI",
            TimeCreated = DateTime.Now.AddDays(-1)
        }
    };

    private List<EntityClient> FilteredClients = new();
    private void FilterClients()
    {
        FilteredClients = _clients.Where(x =>
            string.IsNullOrWhiteSpace(_search)
            || x.Name?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true
            || x.Email?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true
            || x.Phone?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true
            || x.CourseName?.Contains(_search, StringComparison.OrdinalIgnoreCase) == true
        ).ToList();
    }
    public class EntityBase
    {
        public Guid Guid { get; set; }

        public DateTime TimeCreated { get; set; } = DateTime.Now;

        public DateTime TimeModified { get; set; } = DateTime.Now;

        public string? UserCreated { get; set; }

        public string? UserModified { get; set; }
    }

    public class EntityClient : EntityBase
    {
        public string? Name { get; set; }

        public string? Email { get; set; }

        public string? Phone { get; set; }

        public string? Message { get; set; }

        public Guid GuidCourse { get; set; }

        public string? CourseName { get; set; }
    }
}