@page "/admin/courses"
@using ATProManagement.Db
@inject IMainContext _ctx
@inject ISweetAlertService _swal
@inject IDialogService Dialog
@inject IJSRuntime js
<style>
    .custom-table {
        display: flex;
        flex-direction: column;
        height: 600px;
    }

        .custom-table .mud-table-container {
            flex: 1;
            overflow-y: auto;
        }

        .custom-table thead {
            position: sticky;
            top: 0;
            z-index: 2;
            background: var(--mud-palette-background);
        }

    .course-page {
        background: #f7f8fc;
        min-height: 100vh;
        padding: 24px;
    }

    .stat-card {
        border-radius: 20px;
        transition: .3s;
        border: 1px solid rgba(255,111,0,.08);
        box-shadow: 0 6px 20px rgba(0,0,0,.04);
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

    .table-wrapper {
        border-radius: 24px;
    }

    .search-box {
        width: 280px;
    }

    .custom-table .mud-table-head {
        background: rgba(255,111,0,.06);
    }

    .custom-table .mud-table-cell {
        border-bottom: 1px solid #f1f1f1;
    }

    .course-avatar {
        background: linear-gradient(135deg, #FF6F00, #FFA726) !important;
        color: white !important;
    }

    .fw-bold {
        font-weight: 700;
    }

    .gap-2 {
        gap: 8px;
    }

    .gap-4 {
        gap: 16px;
    }

    @@media screen and (max-width: 768px) {

        .course-page {
            padding: 16px;
        }

        .search-box {
            width: 100%;
        }

        .course-header {
            border-radius: 18px;
        }

        .table-wrapper {
            border-radius: 18px;
        }
    }

    /* TABLE CONTAINER */
    .custom-table {
        border-radius: 20px;
        overflow: hidden;
        background: white;
        border: 1px solid rgba(255,111,0,.08);
        box-shadow: 0 6px 24px rgba(0,0,0,.04);
    }

        /* HEADER */
        .custom-table .mud-table-head {
            background: linear-gradient( 135deg, #FF6F00, #FFA726 );
        }

            /* HEADER CELL */
            .custom-table .mud-table-head .mud-table-cell {
                color: white !important;
                font-size: .95rem;
                font-weight: 700;
                letter-spacing: .3px;
                padding-top: 18px;
                padding-bottom: 18px;
                border-bottom: none;
            }

        /* BODY CELL */
        .custom-table .mud-table-body .mud-table-cell {
            padding-top: 16px;
            padding-bottom: 16px;
            border-bottom: 1px solid #f3f3f3;
            font-size: .92rem;
            color: #424242;
            vertical-align: middle;
        }

        /* ROW */
        .custom-table .mud-table-body tr {
            transition: background .2s ease, transform .2s ease;
        }

            /* ROW HOVER */
            .custom-table .mud-table-body tr:hover {
                background: rgba(255,111,0,.04);
            }

            /* STRIPED */
            .custom-table .mud-table-body tr:nth-child(even) {
                background: rgba(0,0,0,.01);
            }

    /* AVATAR */
    .course-avatar {
        background: linear-gradient( 135deg, #FF6F00, #FFA726 ) !important;
        color: white !important;
        width: 42px;
        height: 42px;
        box-shadow: 0 4px 12px rgba(255,111,0,.25);
    }

    /* COURSE NAME */
    .course-name {
        font-weight: 700;
        color: #212121;
        margin-bottom: 2px;
    }

    /* GUID */
    .course-guid {
        color: #9e9e9e;
        font-size: .75rem;
    }

    /* ACTION BUTTON */
    .table-action {
        border-radius: 12px;
        transition: background .2s ease, transform .2s ease;
    }

        .table-action:hover {
            background: rgba(255,111,0,.08);
            transform: scale(1.08);
        }

    /* TABLE TOOLBAR */
    .table-toolbar {
        padding-bottom: 18px;
        border-bottom: 1px solid #f1f1f1;
        margin-bottom: 12px;
    }

    /* SEARCH */
    .search-box .mud-input-control {
        border-radius: 14px;
    }

    /* MOBILE */
    @@media screen and (max-width: 768px) {

        .custom-table {
            border-radius: 16px;
        }

            .custom-table .mud-table-head .mud-table-cell {
                font-size: .85rem;
                padding-top: 14px;
                padding-bottom: 14px;
            }

            .custom-table .mud-table-body .mud-table-cell {
                padding-top: 12px;
                padding-bottom: 12px;
            }
    }

    .mud-ripple-checkbox svg{
        fill: #01579B !important;
    }
</style>
<MudContainer MaxWidth="MaxWidth.False" Class="course-page">
    <!-- HEADER -->
    <Toolbar Title="Courses" OnRefresh="LoadData" OnExcelExport="ExportExcel" OnPdfExport="ExportPDF"/>
    <!-- STATS -->
    <MudGrid Class="mb-4">
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="stat-card orange-gradient">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">
                        Total Courses
                    </MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        @(_courses?.Count ?? 0)
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">

            <MudCard Class="stat-card">

                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">
                        Active
                    </MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        18
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="stat-card">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">
                        Students
                    </MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        1,240
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
        <MudItem xs="12" sm="6" md="3">
            <MudCard Class="stat-card">
                <MudCardContent>
                    <MudText Typo="Typo.subtitle2">
                        Completed
                    </MudText>
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        320
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>

    <!-- TABLE -->
    <MudPaper Class="table-wrapper pa-4">

        <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-4">

            <MudText Typo="Typo.h6">
                Course List
            </MudText>

            <MudTextField T="string"
                          Immediate="true"
                          Placeholder="Search course..."
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Class="search-box"
                          ValueChanged="OnSearchChanged" />
            <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled">
                <MudIconButton Icon="@Icons.Material.Filled.Add" OnClick="AddNew"></MudIconButton>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" OnClick="DeleteRange"></MudIconButton>
            </MudButtonGroup>
        </div>
        @if (_courses?.Count > 0)
        {
            <div class="table-scroll">

                <MudTable 
                          T="EntityCourse"
                          @bind-SelectedItems="_selectedCourses"
                          MultiSelection="true"
                          Items="_courses"
                          RowsPerPage="25"
                          Hover="true"
                          Dense="true"
                          Striped="true"
                          Breakpoint="Breakpoint.Sm"
                          Class="custom-table">
                    <HeaderContent>
                        <MudTh>Course Name</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh>User Created</MudTh>
                        <MudTh>User Modified</MudTh>
                        <MudTh Class="text-center">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Class="course-avatar">
                                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" />
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body1" Class="course-name">
                                        @context.Name
                                    </MudText>
                                    <MudText Typo="Typo.caption" Class="course-name">
                                        @context.Guid
                                    </MudText>
                                </div>
                            </div>
                        </MudTd>
                        <MudTd>
                            @context.Description
                        </MudTd>
                        <MudTd>
                            @context.TimeCreated.ToString("dd/MM/yyyy")
                        </MudTd>
                        <MudTd>
                            @context.UserCreated
                        </MudTd>
                        <MudTd>
                            @context.UserModified
                        </MudTd>
                        <MudTd Class="text-center">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Color="Color.Warning" Class="table-action"
                                           OnClick=@(() => TableAction(context.Guid, "Edit")) />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error" Class="table-action"
                                           OnClick=@(() => TableAction(context.Guid, "Delete")) />
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager />
                    </PagerContent>
                </MudTable>
            </div>
        }
    </MudPaper>
</MudContainer>
@{
     content = @<MudGrid Spacing="3" Class="mt-2">
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="model.Guid"
                          Label="Guid"
                          Class="input-field" ReadOnly Disabled/>
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField @bind-Value="model.Name"
                          Label="Course Name"
                          Class="input-field" 
                          Required/>
        </MudItem>
        <MudItem xs="12" sm="12">
            <MudTextField @bind-Value="model.Description"
                          Label="Description"
                          Class="input-field" />
        </MudItem>
        <MudItem xs="6" sm="6">
            <MudTextField @bind-Value="model.UserCreated"
                          Label="User Created"
                          Class="input-field" ReadOnly Disabled/>
        </MudItem>
        <MudItem xs="6" sm="6">
            <MudTextField @bind-Value="model.UserModified"
                          Label="User Modified"
                          Class="input-field" ReadOnly Disabled/>
        </MudItem>
        <MudItem xs="6" sm="6">
            <MudTextField @bind-Value="model.TimeCreated"
                          Label="Time"
                          Class="input-field" ReadOnly Disabled/>
        </MudItem>
        <MudItem xs="6" sm="6">
            <MudTextField @bind-Value="model.TimeModified"
                          Label="Time Modified  "
                          Class="input-field" ReadOnly Disabled/>
        </MudItem>
    </MudGrid>;
    footer = @<div>
    <MudButton Color="Color.Secondary"
                         Variant="Variant.Filled"
                         StartIcon="@Icons.Material.Filled.Close"
                       Class="btn-cancel"
                       OnClick="DialogCancel">Cancel</MudButton>
    <MudButton
           StartIcon = "@Icons.Material.Filled.Save"
           Variant = "Variant.Filled"
           Color = "Color.Primary"
           OnClick="Save"
           Class = "btn-save">Save
        </MudButton>
    </div>;
}
@code {
    private HashSet<EntityCourse> _selectedCourses = new();
    RenderFragment content;
    RenderFragment footer;
    ICourseService? service;
    private string _search = "";
    List<EntityCourse>? _dataSource;
    List<EntityCourse>? _courses;
    ModelCourse model = new();
    private IDialogReference? _dialog;
    protected override async Task OnInitializedAsync()
    {
        await _swal.Loading();
        service = _ctx.GetService<ICourseService>();
        await LoadData();
        await _swal.Close();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await service.GetData();

            if (result?.Success == true)
            {
                _dataSource = result.Items?.ToList();
                _courses = _dataSource;
            }
            else
            {
                await _swal.Error(result?.Message ?? "Error");
            }
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private void OnSearchChanged(string value)
    {
        _courses = _dataSource?.Where(x => x.Name.ToUpper().Contains(value.ToUpper()) || x.Description.ToUpper().Contains(value.ToUpper())).ToList();
    }

    private async Task TableAction(Guid guid, string action)
    {
        try
        {
            switch (action)
            {
                case "Delete":
                    await Delete(guid);
                    break;
                case "Edit":
                    await Edit(guid);
                    break;
                default:
                    break;
            }
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message, action);
        }
    }

    private async Task AddNew()
    {
        try{
            model = new();
            await Edit(new Guid());
        }catch(Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private async Task Edit(Guid guid)
    {
        try
        {
            model = _dataSource?.FirstOrDefault(x => x.Guid == guid)?.ToModel<ModelCourse>() ?? new ModelCourse();
            var parameters = new DialogParameters
            {
                ["Model"] = model,
                ["Title"] = "Edit Course|Fill automatically",
                ["ChildContent"] = content,
                ["ChildFooter"] = footer
            };
            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
            };

            _dialog = await Dialog.ShowAsync<BaseDialog>("", parameters, options);
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }

    }

    private async Task Delete(Guid guid)
    {
        var result = await _swal.Confirm("Conrfirm delete item?", "Delete");
        if (result == false) return;
        var respone = await service.Delete(guid);
        if (respone.Success)
        {
            await _swal.Success("Delete Successfully");
            await LoadData();
        }
        else
        {
            await _swal.Error(respone.Message);
        }
    }

    private async Task DeleteRange()
    {
        try{
            if (!_selectedCourses.Any())
            {
                await _swal.Warning("Please select at least one course to delete.");
                return;
            }

            var result = await _swal.Confirm($"Confirm delete {_selectedCourses.Count} selected items?", "Delete");
            if (result == false) return;

            var respone = await service.RemoveRange(_selectedCourses.ToList());
            if (respone.Success)
            {
                await _swal.Success("Delete Successfully");
                await LoadData();
            }
            else
            {
                await _swal.Error(respone.Message);
            }
        }catch(Exception ex){
            await _swal.Error(ex.Message);
        }

       
    }

    private async Task Save()
    {
        try
        {
            var result = await _swal.Confirm("Confirm save item?", "Save");
            if (result)
            {
                await Submit(model);
                DialogCancel();
                await LoadData();
            }
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private void DialogCancel()
    {
        _dialog?.Close();
    }

    private async Task Submit(ModelCourse model)
    {
        try
        {
            await _swal.Loading("Saving...");
            var result = await service.Submit(model);
            await _swal.Close();
            if (result.Success) await _swal.Success("Save Successfully");
            else await _swal.Error(result?.Message);
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private async Task ExportExcel()
    {
        try
        {
            await _swal.Loading("Downloading...");
            await DownloadHelper.ExportToExcel<EntityCourse>(_courses ?? new List<EntityCourse>(), js,"Courses.xlsx");
            await _swal.Success("Download successful");
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }

    private async Task ExportPDF()
    {
        try
        {
            await _swal.Loading("Downloading...");
            await DownloadHelper.ExportToPdf<EntityCourse>(_courses ?? new List<EntityCourse>(), js);
            await _swal.Success("Download successful");
        }
        catch (Exception ex)
        {
            await _swal.Error(ex.Message);
        }
    }
}