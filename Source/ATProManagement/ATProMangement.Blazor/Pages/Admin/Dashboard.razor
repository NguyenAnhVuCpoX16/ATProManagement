<MudGrid Class="dashboard-container">
    <!-- HEADER -->
    <MudItem xs="12">

        <MudPaper Class="pa-6 dashboard-header" Elevation="0">

            <MudText Typo="Typo.h4" Class="fw-bold">
                Dashboard
            </MudText>

            <MudText Typo="Typo.body1" Class="mud-text-secondary text-white">
                Welcome back 👋 Here's what's happening today.
            </MudText>

        </MudPaper>

    </MudItem>

    <!-- STATS -->
    <MudItem xs="12" sm="6" md="3">

        <MudCard Class="dashboard-card revenue-card">

            <MudCardContent>

                <div class="d-flex justify-space-between align-center">

                    <div>

                        <MudText Typo="Typo.subtitle2">
                            Revenue
                        </MudText>

                        <MudText Typo="Typo.h4" Class="fw-bold">
                            $24,500
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text">
                            +12%
                        </MudChip>

                    </div>

                    <MudAvatar Color="Color.Warning" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.AttachMoney" />
                    </MudAvatar>

                </div>

            </MudCardContent>

        </MudCard>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudCard Class="dashboard-card">

            <MudCardContent>

                <div class="d-flex justify-space-between align-center">

                    <div>

                        <MudText Typo="Typo.subtitle2">
                            Orders
                        </MudText>

                        <MudText Typo="Typo.h4" Class="fw-bold">
                            1,245
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Info"
                                 Variant="Variant.Text">
                            +8%
                        </MudChip>

                    </div>

                    <MudAvatar Class="orange-avatar" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" />
                    </MudAvatar>

                </div>

            </MudCardContent>

        </MudCard>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudCard Class="dashboard-card">

            <MudCardContent>

                <div class="d-flex justify-space-between align-center">

                    <div>

                        <MudText Typo="Typo.subtitle2">
                            Customers
                        </MudText>

                        <MudText Typo="Typo.h4" Class="fw-bold">
                            845
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Text">
                            +21%
                        </MudChip>

                    </div>

                    <MudAvatar Color="Color.Primary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.People" />
                    </MudAvatar>

                </div>

            </MudCardContent>

        </MudCard>

    </MudItem>

    <MudItem xs="12" sm="6" md="3">

        <MudCard Class="dashboard-card">

            <MudCardContent>

                <div class="d-flex justify-space-between align-center">

                    <div>

                        <MudText Typo="Typo.subtitle2">
                            Products
                        </MudText>

                        <MudText Typo="Typo.h4" Class="fw-bold">
                            312
                        </MudText>

                        <MudChip T="string"
                                 Color="Color.Warning"
                                 Variant="Variant.Text">
                            +5%
                        </MudChip>

                    </div>

                    <MudAvatar Color="Color.Secondary" Size="Size.Large">
                        <MudIcon Icon="@Icons.Material.Filled.Inventory2" />
                    </MudAvatar>

                </div>

            </MudCardContent>

        </MudCard>

    </MudItem>

    <!-- CHART -->
    <MudItem xs="12" md="8">

        <MudPaper Class="pa-4 chart-card">

            <div class="d-flex justify-space-between align-center mb-4">

                <MudText Typo="Typo.h6">
                    Revenue Analytics
                </MudText>

                <MudChip T="string"
                         Color="Color.Warning">
                    Monthly
                </MudChip>

            </div>

            <MudChart T="double"
                      ChartType="ChartType.Line"
                      ChartSeries="_series"
                      ChartLabels="_labels"
                      Width="100%"
                      Height="350px"
                      ChartOptions="_options" />

        </MudPaper>

    </MudItem>

    <!-- ACTIVITY -->
    <MudItem xs="12" md="4">

        <MudPaper Class="pa-4 activity-card">

            <MudText Typo="Typo.h6" Class="mb-4">
                Recent Activity
            </MudText>

            <MudTimeline>

                <MudTimelineItem Color="Color.Success">
                    New order received
                </MudTimelineItem>

                <MudTimelineItem Color="Color.Info">
                    Customer registered
                </MudTimelineItem>

                <MudTimelineItem Color="Color.Warning">
                    Product stock low
                </MudTimelineItem>

                <MudTimelineItem Color="Color.Error">
                    Payment failed
                </MudTimelineItem>

            </MudTimeline>

        </MudPaper>

    </MudItem>

    <!-- TABLE -->
    <MudItem xs="12" md="8">

        <MudPaper Class="pa-4 table-card">

            <div class="d-flex justify-space-between align-center mb-4">

                <MudText Typo="Typo.h6">
                    Recent Orders
                </MudText>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Warning">
                    View All
                </MudButton>

            </div>

            <MudTable Items="_orders"
                      Hover="true"
                      Dense="true"
                      Striped="true">

                <HeaderContent>

                    <MudTh>Order ID</MudTh>
                    <MudTh>Customer</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Status</MudTh>

                </HeaderContent>

                <RowTemplate>

                    <MudTd>@context.Id</MudTd>
                    <MudTd>@context.Customer</MudTd>
                    <MudTd>@context.Total</MudTd>

                    <MudTd>

                        <MudChip T="string"
                                 Color="Color.Success"
                                 Variant="Variant.Filled">
                            @context.Status
                        </MudChip>

                    </MudTd>

                </RowTemplate>

            </MudTable>

        </MudPaper>

    </MudItem>

    <!-- QUICK ACTION -->
    <MudItem xs="12" md="4">

        <MudPaper Class="pa-4 quick-card">

            <MudText Typo="Typo.h6" Class="mb-4">
                Quick Actions
            </MudText>

            <div class="d-grid gap-3">

                <MudButton FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Add"
                           Variant="Variant.Filled"
                           Color="Color.Warning">

                    Add Product

                </MudButton>

                <MudButton FullWidth="true"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           Variant="Variant.Outlined"
                           Color="Color.Warning">

                    Add Customer

                </MudButton>

                <MudButton FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Assessment"
                           Variant="Variant.Text"
                           Color="Color.Warning">

                    Generate Report

                </MudButton>

            </div>

        </MudPaper>

    </MudItem>

</MudGrid>

<style id="mrk0s7">
    .dashboard-container {
        padding: 24px;
        background: #f7f8fc;
        min-height: 100vh;
    }

    .dashboard-header {
        background: linear-gradient(135deg, #FF6F00, #ff9800);
        color: white;
        border-radius: 20px;
    }

    .dashboard-card {
        border-radius: 18px;
        transition: .3s;
    }

    .dashboard-card:hover {
        transform: translateY(-4px);
    }

    .chart-card,
    .activity-card,
    .table-card,
    .quick-card {
        border-radius: 18px;
    }

    .orange-avatar {
        background: #FF6F00;
        color: white;
    }

    .revenue-card {
        background: linear-gradient(135deg, #fff3e0, #ffffff);
    }

    .fw-bold {
        font-weight: 700;
    }

    .d-grid {
        display: grid;
    }

    .gap-3 {
        gap: 12px;
    }
    /* CARD */
    .dashboard-card {
        position: relative;
        overflow: hidden;
        border-radius: 24px;
        background: rgba(255,255,255,.95);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,111,0,.08);
        box-shadow: 0 4px 12px rgba(0,0,0,.04), 0 12px 24px rgba(255,111,0,.08);
        transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease;
        min-height: 150px;
    }

        /* HOVER */
        .dashboard-card:hover {
            transform: translateY(-6px);
            border-color: rgba(255,111,0,.25);
            box-shadow: 0 10px 20px rgba(0,0,0,.06), 0 18px 40px rgba(255,111,0,.16);
        }

        /* ORANGE TOP LINE */
        .dashboard-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient( 90deg, #FF6F00, #FFA726 );
        }

        /* CARD CONTENT */
        .dashboard-card .mud-card-content {
            padding: 24px;
        }

        /* TITLE */
        .dashboard-card .mud-typography-subtitle2 {
            color: #757575;
            font-size: .95rem;
            font-weight: 500;
            margin-bottom: 10px;
        }

        /* VALUE */
        .dashboard-card .mud-typography-h4 {
            font-weight: 800;
            color: #212121;
            margin-bottom: 8px;
            letter-spacing: -.5px;
        }

        /* CHIP */
        .dashboard-card .mud-chip {
            font-weight: 700;
            border-radius: 10px;
            background: rgba(255,111,0,.08);
            color: #FF6F00;
        }

        /* AVATAR */
        .dashboard-card .mud-avatar {
            width: 64px;
            height: 64px;
            border-radius: 18px;
            background: linear-gradient( 135deg, #FF6F00, #FFA726 ) !important;
            box-shadow: 0 10px 20px rgba(255,111,0,.25);
            transition: .25s;
        }

            /* ICON */
            .dashboard-card .mud-avatar .mud-icon-root {
                font-size: 32px;
                color: white;
            }

        /* AVATAR HOVER */
        .dashboard-card:hover .mud-avatar {
            transform: scale(1.08) rotate(-4deg);
        }

    /* SPECIAL REVENUE CARD */
    .revenue-card {
        background: linear-gradient( 135deg, rgba(255,111,0,.08), rgba(255,167,38,.05) ), white;
    }

    /* MOBILE */
    @@media screen and (max-width: 768px) {

        .dashboard-card {
            border-radius: 18px;
            min-height: auto;
        }

            .dashboard-card .mud-card-content {
                padding: 18px;
            }

            .dashboard-card .mud-avatar {
                width: 52px;
                height: 52px;
            }

                .dashboard-card .mud-avatar .mud-icon-root {
                    font-size: 26px;
                }
    }

</style>

