@page "/login"
@using System.Net.Http.Json;
@inject HttpClient Http
@inject NavigationManager Nav
@inject Blazored.LocalStorage.ILocalStorageService Storage
@layout EmptyLayout
@inject ISweetAlertService _swal
<div class="login-wrapper">
    <MudCard Class="login-card pa-6">
        <div class="login-header">
            <div class="logo">AT</div>
            <MudText Typo="Typo.h5" Class="title">Welcome Back</MudText>
            <MudText Typo="Typo.body2" Class="subtitle">
                Sign in to continue
            </MudText>
        </div>

        <MudTextField @bind-Value="model.Email"
                      Label="Email"
                      Variant="Variant.Outlined"
                      Class="mt-4" 
                      AdornmentColor="Color.Surface"
                      />

        <MudTextField @bind-Value="model.Password"
                      Label="Password"
                      InputType="InputType.Password"
                      Variant="Variant.Outlined"
                      Class="mt-3" />

        <div class="options">
            <MudCheckBox @bind-Checked="rememberMe" T="bool" Color="Color.Success">
                Remember me
            </MudCheckBox>
        </div>

        <MudButton Class="login-btn mt-4"
                   FullWidth="true"
                   OnClick="HandleLogin">
            Login
        </MudButton>

        @if (!string.IsNullOrEmpty(error))
        {
            <MudText Color="Color.Error" Class="mt-3">@error</MudText>
        }

    </MudCard>

</div>

@code {
    private LoginModel model = new();
    private string? error;
    private bool rememberMe = true;
    private async Task HandleLogin()
    {
        await _swal.Loading("Please wait...");
        var response = await Http.PostAsJsonAsync("/login", model);

        if (!response.IsSuccessStatusCode)
        {
            await _swal.Error("Login failed");
            return;
        }

        var token = await response.Content.ReadAsStringAsync();

        var authToken = new AuthToken
        {
            Token = token,
            ExpireAt = DateTime.UtcNow.AddDays(1)
        };

        if (rememberMe)
            await Storage.SetItemAsync("auth", authToken);
        else
            await Storage.SetItemAsync("auth", authToken);
        await _swal.Close();
        Nav.NavigateTo("/");
    }

    class LoginModel
    {
        public string Email { get; set; }
        public string Password { get; set; }
    }
}

