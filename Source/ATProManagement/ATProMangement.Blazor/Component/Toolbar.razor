<MudPaper Class="toolbar-container pa-3 mb-4" Elevation="0">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6" Class="text-main">
            @Title
        </MudText>
        <MudSpacer />
        <MudButtonGroup Color="Color.Secondary"
                        Variant="Variant.Outlined" Class="menu-toolbar">
            <MudIconButton Icon="@Icons.Material.Filled.FilterAlt"
                           Color="Color.Secondary" />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           OnClick="Refresh"
                           Color="Color.Secondary" />
            <MudMenu Icon="@Icons.Material.Filled.ArrowDropDown">
                <MudMenuItem OnClick="PdfExport">
                    Export PDF
                </MudMenuItem>
                <MudMenuItem OnClick="ExcelExport">
                    Export Excel
                </MudMenuItem>
                <MudMenuItem OnClick="ExcelImport">
                    Import Excel
                </MudMenuItem>
            </MudMenu>
        </MudButtonGroup>
    </div>
</MudPaper>

<style>
    .toolbar-container {
        border-radius: 18px;
        background: white;
        border: 1px solid rgba(255,111,0,.08);
        box-shadow: 0 4px 12px rgba(0,0,0,.04);
        position: relative;
    }

    .menu-toolbar button{
        border-radius: 0px !important;
    }
</style>
@code{
    [Parameter]
    public string Title { get; set; } = "ATPro";
    
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    [Parameter]
    public EventCallback OnFilter { get; set; }

    [Parameter]
    public EventCallback OnExcelExport { get; set; }

    [Parameter]
    public EventCallback OnExcelImport { get; set; }

    [Parameter]
    public EventCallback OnPdfExport { get; set; }

    private async Task Refresh()
    {
        await OnRefresh.InvokeAsync();
    }

    private async Task Filter()
    {
        await OnFilter.InvokeAsync();
    }

    private async Task ExcelExport()
    {
        await OnExcelExport.InvokeAsync();
    }

    private async Task ExcelImport()
    {
        await OnExcelImport.InvokeAsync();
    }

    private async Task PdfExport()
    {
        await OnPdfExport.InvokeAsync();
    }
}