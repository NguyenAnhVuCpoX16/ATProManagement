@using System.Threading.Tasks
@using MudBlazor
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LayoutStateService LayoutState
@inject IMainContext _ctx
@implements IDisposable
@inject ISweetAlertService _swal
@inject IDialogService Dialog
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <AppBar Open="_open" OpenChanged="OnOpenChanged" />
    <MudDrawer @bind-Open="_open"
               Elevation="1"
               Fixed="true"
               Variant="variant"
               OpenMiniOnHover="true"
               Breakpoint="Breakpoint.None"
               ClipMode="DrawerClipMode.Always"
               Class="sidebar">
        <MudNavMenu>
            <NavMenu />
        </MudNavMenu>
    </MudDrawer>
    @if (_layoutReady)
    {
        <MudMainContent>
            @Body
        </MudMainContent>
    }
</MudLayout>
@code {
    private int Width;
    private bool _open = false;
    DrawerVariant variant => Width < 756
            ? DrawerVariant.Responsive
            : DrawerVariant.Mini;
    private DotNetObjectReference<MainLayout>? _objRef;
    private bool _layoutReady;
    private bool _isAuthenticated = false;
    private bool _disposed;

    [JSInvokable]
    public void UpdateBrowserWidth(int width)
    {
        Width = width;
        LayoutState.SetDesktop(width >= 756);

        ResetUI();
        InvokeAsync(() =>
        {
            ResetUI();
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += Refresh;
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAuthenticated = authState.User.Identity?.IsAuthenticated ?? false;

        if (!_isAuthenticated)
        {
            Nav.NavigateTo("/login", true);
        }
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
            return;
        try
        {
            if (firstRender)
            {
                _layoutReady = true;
                _objRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync(
                    "browserSize.registerResizeCallback",
                    _objRef
                );
            }
        }
        catch (TaskCanceledException)
        {
            // Ignore
        }
        catch (JSDisconnectedException)
        {
            // Blazor Server disconnect
        }
        catch (ObjectDisposedException)
        {
            // Component disposed
        }

    }

    public void Dispose()
    {
        _objRef?.Dispose();
        LayoutState.OnChange -= Refresh;
        _objRef?.Dispose();
    }

    private async void Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnOpenChanged(bool value)
    {
        _open = value;
    }

    private void ResetUI()
    {
        _open = true;
        StateHasChanged();
        _open = false;
    }
}