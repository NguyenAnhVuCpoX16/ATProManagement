@using MudBlazor
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LayoutStateService LayoutState
@implements IDisposable

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <AppBar Open="_open" OpenChanged="OnOpenChanged" />
    <MudDrawer @bind-Open="_open"
               Elevation="1"
               Fixed="true"
               Variant="variant"
               OpenMiniOnHover="true"
               Breakpoint="Breakpoint.None"
               ClipMode="DrawerClipMode.Always"
               Class="sidebar">
        <MudNavMenu>
            <NavMenu />
        </MudNavMenu>
    </MudDrawer>
    @if(_layoutReady){
    <MudMainContent>
        @Body
    </MudMainContent>
    }
</MudLayout>
@code {
    private int Width;
    private bool _open = false;
    DrawerVariant variant => Width < 756
            ? DrawerVariant.Responsive
            : DrawerVariant.Mini;
    private DotNetObjectReference<MainLayout>? _objRef;
    private bool _layoutReady;

    [JSInvokable]
    public void UpdateBrowserWidth(int width)
    {
        Width = width;
        LayoutState.SetDesktop(width >= 756);

        ResetUI();
        InvokeAsync(() =>
        {
            ResetUI();
            StateHasChanged();
        });
    }

    protected override void OnInitialized()
    {
        LayoutState.OnChange += Refresh;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layoutReady = true;
            _objRef = DotNetObjectReference.Create(this);

            await JS.InvokeVoidAsync(
                "browserSize.registerResizeCallback",
                _objRef
            );
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
        LayoutState.OnChange -= Refresh;
    }

    private async void Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnOpenChanged(bool value)
    {
        _open = value;
    }

    private void ResetUI()
    {
        _open = true;
        StateHasChanged();
        _open = false;
    }
}