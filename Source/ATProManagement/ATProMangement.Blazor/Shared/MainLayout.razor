@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Style="color: #FF6F00" Edge="Edge.Start" OnClick="@ToggleDrawer" />
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Secondary" Style="color: #FF6F00" />
        <MudIconButton Icon="@Icons.Material.Filled.Notifications" Href="#" Color="Color.Info"/>
        <MudIconButton Icon="@Icons.Custom.Brands.GitHub" Style="color: #FF6F00" Href="https://github.com/MudBlazor/MudBlazor" Target="_blank" />
    </MudAppBar>
    <MudDrawer @bind-Open="@_open" Elevation="1">
        <MudNavMenu>
           <NavMenu/>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="pt-16 px-16">
            @Body
    </MudMainContent>
</MudLayout>
@code {
    private bool _open = false;

    private void ToggleDrawer()
    {
        _open = !_open;
    }
}