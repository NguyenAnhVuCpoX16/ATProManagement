@using System.Threading.Tasks
@using MudBlazor
@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject LayoutStateService LayoutState
@inject IMainContext _ctx
@implements IDisposable
@inject ISweetAlertService _swal
@inject IDialogService Dialog
<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
<MudLayout>
    <AppBar Open="_open" OpenChanged="OnOpenChanged" />
    <MudDrawer @bind-Open="_open"
    Elevation="1"
    Fixed="true"
    Variant="variant"
    OpenMiniOnHover="true"
    Breakpoint="Breakpoint.None"
    ClipMode="DrawerClipMode.Always"
    Class="sidebar">
        <MudNavMenu>
            <NavMenu />
        </MudNavMenu>
    </MudDrawer>
    @if(_layoutReady){
        <MudMainContent>
            @Body
        </MudMainContent>
    }
    </MudLayout>
@{
    content = @<MudTextField @bind-Value="_passWord"
                             T="string"
                             InputType="InputType.Password"
                             Placeholder="Nhập mã bí mật..."
                             Label="Password"
                             OnKeyDown="Password_Keydown">
            </MudTextField>        
    ;
    footer = @<MudButton Color="Color.Secondary" 
                         Variant="Variant.Filled"
                         StartIcon="@Icons.Material.Filled.Check"
                         OnClick="ConfirmPassword">
                         Confirm
            </MudButton>        
    ;
}

@code {
    RenderFragment content;
    RenderFragment footer;
    private int Width;
    private bool _open = false;
    DrawerVariant variant => Width < 756
            ? DrawerVariant.Responsive
            : DrawerVariant.Mini;
    private DotNetObjectReference<MainLayout>? _objRef;
    private IDialogReference? _dialog;
    private bool _layoutReady;
    private string _passWord;

    [JSInvokable]
    public void UpdateBrowserWidth(int width)
    {
        Width = width;
        LayoutState.SetDesktop(width >= 756);

        ResetUI();
        InvokeAsync(() =>
        {
            ResetUI();
            StateHasChanged();
        });
    }

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += Refresh;
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _layoutReady = true;
            _objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync(
                "browserSize.registerResizeCallback",
                _objRef
            );
            if(!await _ctx.ExistCookie("Admin"))
            {
                var parameters = new DialogParameters
                {
                    ["Title"] = $"Hello, Admin! Confirm your password to continue.|Fill automatically",
                    ["ChildContent"] = content,
                    ["ChildFooter"] = footer
                };
                var options = new DialogOptions
                {
                    MaxWidth = MaxWidth.Medium,
                    FullWidth = true,
                    CloseOnEscapeKey = false,
                    BackdropClick = false
                };
                _dialog = await Dialog.ShowAsync<BaseDialog>("", parameters, options);
            }
        }
    }

    public void Dispose()
    {
        _objRef?.Dispose();
        LayoutState.OnChange -= Refresh;
    }

    private async void Refresh()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void OnOpenChanged(bool value)
    {
        _open = value;
    }

    private async Task ConfirmPassword()
    {
        var passwordReal = "zzzz";
        if (_passWord == passwordReal)
        {
            await _ctx.SetCookie("Admin", true);
            _dialog.Close();
        }
        else
        {
            await _swal.Error("Sai mất rồi!");
        }
    }

    private void ResetUI()
    {
        _open = true;
        StateHasChanged();
        _open = false;
    }

    private async Task Password_Keydown(KeyboardEventArgs args)
    {
        if(args.Key == "Enter")
        {
            await ConfirmPassword();
        }
    }
}