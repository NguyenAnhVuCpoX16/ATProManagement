@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
<MudPaper Width="250px" Elevation="0">
    <MudNavMenu>
        <MudNavLink Href="/" Icon="@Icons.Material.Filled.Dashboard" IconColor="Color.Surface" Match="NavLinkMatch.All" Class="text-white custom-nav-link">
            Dashboard
        </MudNavLink>
        <MudNavGroup Title="Education" Icon="@Icons.Material.Filled.PlaylistAddCircle" IconColor="Color.Surface" Class="text-white custom-nav-link nav-list">
            <MudNavLink Href="/admin/courses" Icon="@Icons.Material.Filled.ChecklistRtl" IconColor="Color.Surface" Class="text-white custom-nav-link">Courses</MudNavLink>
            <MudNavLink Href="/admin/clients" Icon="@Icons.Material.Filled.SupervisedUserCircle" IconColor="Color.Surface" Class="text-white custom-nav-link">Client</MudNavLink>
        </MudNavGroup>
        <MudNavLink Href="/x" Icon="@Icons.Material.Filled.Language" IconColor="Color.Surface" Class="text-white custom-nav-link">Servers</MudNavLink>
        <MudNavLink Href="/register-course" Icon="@Icons.Material.Filled.AppRegistration" IconColor="Color.Surface" Class="text-white custom-nav-link">Servers</MudNavLink>
        <MudNavLink Href="/x" Icon="@Icons.Material.Filled.Settings" IconColor="Color.Surface" Class="text-white custom-nav-link">Settings</MudNavLink>
        <MudNavLink Href="/x" Icon="@Icons.Material.Filled.QuestionAnswer" IconColor="Color.Surface" Class="text-white custom-nav-link">About</MudNavLink>
        <MudNavLink OnClick="Logout"  Icon="@Icons.Material.Filled.Logout" IconColor="Color.Surface" Class="text-white custom-nav-link">Log out</MudNavLink>
    </MudNavMenu>
</MudPaper>

@code{
    private async Task Logout()
    {
        await Storage.RemoveItemAsync("token");
        ((CustomAuthStateProvider)AuthStateProvider).NotifyUserChanged();
        Nav.NavigateTo("/login", true);
    }
}
<style>

    aside.mud-drawer {
        height: 100vh !important;
        background: linear-gradient(180deg,rgba(255, 111, 0, 1) 0%, rgba(255, 244, 140, 1) 100%) !important;
    }

    .sidebar .mud-paper,
    .sidebar.mud-drawer--closed .mud-nav-link.active {
        background: transparent !important;
    }

        .mud-drawer--closed .mud-nav-link.active .mud-nav-link-icon {
            fill: #fff;
            background: rgba(255, 244, 140, .5);
            border-radius: 5px;
            margin-right: 0px;
        }

    .mud-nav-link .mud-nav-link-expand-icon, 
    .mud-navmenu.mud-navmenu-default .mud-nav-link-expand-icon.mud-transform {
        fill: #fff;
    }

    .mud-nav-link {
        padding: 15px 10px;
    }

        .mud-nav-link:hover, .mud-nav-link.active {
            background: rgba(255,255,255,1) !important;
            color: #FF6F00 !important;
        }

            .mud-nav-link:hover .mud-nav-link-expand-icon,
            .mud-nav-link:hover .mud-nav-link-expand-icon.mud-transform{
                fill: #FF6F00;
            }

    .mud-drawer-mini.mud-drawer--closed .nav-list svg.mud-nav-link-expand-icon{
        display: none;
    }
    .mud-drawer-mini.mud-drawer--open .nav-list svg.mud-nav-link-expand-icon{
        display: block;
    }

    .mud-nav-link .mud-nav-link-icon,
    .mud-nav-link .mud-nav-link-icon {
        width: 35px;
        height: 35px;
    }
   
</style>